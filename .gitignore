# database backups (keep the dir, ignore the dumps)
/backups/*
!/backups/.gitkeep

/apps/api/secrets/eirms/*
!/apps/api/secrets/eirms/.gitkeep

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock
/legal-documents/*
!/legal-documents/.gitkeep

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
/apps/api/dist

# HashiCorp Vault local state — secrets on disk, never commit. Keep the dirs
# themselves tracked (via .gitkeep) so docker bind-mounts find a target on a
# fresh clone instead of creating root-owned directories.
/vault/data/*
/vault/audit/*
/vault/approle/*
!/vault/data/.gitkeep
!/vault/audit/.gitkeep
!/vault/approle/.gitkeep

# Observability stack runtime state — TSDB, chunks, grafana sqlite. Configs
# under observability/{prometheus,loki,promtail,grafana} stay tracked.
/observability/prometheus/data/*
/observability/loki/data/*
/observability/grafana/data/*
!/observability/prometheus/data/.gitkeep
!/observability/loki/data/.gitkeep
!/observability/grafana/data/.gitkeep

/exports/*
!/exports/.gitkeep
docs/wthholding_receipt_1.pdf
docs/receipt_2.pdf
docs/receipt_1.pdf
docs/debit_ref_1.pdf
docs/credit_ref_1.pdf

