{
  "uid": "eirms-audit-actions",
  "title": "EIRMS Audit — System Actions",
  "tags": ["eirms", "audit"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "API instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(up{job=\"api\"}, instance)", "refId": "A" },
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Inbound actions / min (all)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(audit_inbound_total{instance=~\"$instance\"}[5m])) * 60",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Outbound EIRMS calls / min",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(audit_outbound_total{instance=~\"$instance\"}[5m])) * 60",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "EIRMS success rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(audit_outbound_total{success=\"true\",instance=~\"$instance\"}[15m])) / clamp_min(sum(rate(audit_outbound_total{instance=~\"$instance\"}[15m])), 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.9 },
              { "color": "green", "value": 0.98 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Auth failures / hr",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(auth_events_total{result=\"failure\",instance=~\"$instance\"}[1h])) * 3600",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "INBOUND action rate by action (top 8)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "topk(8, sum by (action) (rate(audit_inbound_total{instance=~\"$instance\"}[5m])))",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "cps" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "OUTBOUND EIRMS action rate by action",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (action) (rate(audit_outbound_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "cps" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "EIRMS OUTBOUND — success vs failure",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(audit_outbound_total{success=\"true\",instance=~\"$instance\"}[5m]))",
          "legendFormat": "success",
          "refId": "A"
        },
        {
          "expr": "sum(rate(audit_outbound_total{success=\"false\",instance=~\"$instance\"}[5m]))",
          "legendFormat": "failure",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "stacking": { "mode": "normal" } },
          "unit": "cps"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Auth events by result",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (event, result) (rate(auth_events_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{event}} — {{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "cps" } }
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Recent audit events (JSON log stream)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 10 },
      "targets": [
        {
          "expr": "{compose_service=\"api\", stream=\"audit\"} | json",
          "refId": "A"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true }
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Failed EIRMS OUTBOUND calls",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "{compose_service=\"api\", stream=\"audit\"} | json | kind=\"OUTBOUND\" | success=\"false\"",
          "refId": "A"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "All API logs (raw)",
      "description": "Every log line the API container writes — bypasses the audit filter so nothing is invisible.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 38, "w": 24, "h": 10 },
      "targets": [
        {
          "expr": "{compose_service=\"api\"}",
          "refId": "A"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true }
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Errors & warnings across every service",
      "description": "Any container emitting ERROR/WARN. Matches Nest's `[Nest] ... ERROR/WARN` prefix as well as JSON-log level fields.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 48, "w": 24, "h": 10 },
      "targets": [
        {
          "expr": "{compose_project=~\".+\"} |~ \"(?i)(ERROR|WARN|Nest\\\\] .* (ERROR|WARN))\"",
          "refId": "A"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true }
    }
  ]
}
