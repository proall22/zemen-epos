# EIRMS (MOR core) credentials for Zemen-ePos
# Test env accepts http + https; PRODUCTION is https-only and requires the
# signed-envelope (see EIRMS_SIGNING_* below).
EIRMS_BASE_URL=http://core.mor.gov.et
EIRMS_CLIENT_ID=00000000-0000-0000-0000-000000000000
EIRMS_CLIENT_SECRET=
EIRMS_API_KEY=00000000-0000-0000-0000-000000000000
EIRMS_TIN=

# EIRMS request signing (required for the https/production gateway). Platform
# config — provisioned on the host, never via the app. Point these at the
# INSA-issued files on the VPS (absolute paths). When BOTH resolve, every MoR
# request is wrapped as { request, signature, certificate } and sent over
# https; when unset, the bare-body http path is used (test env). See README /
# docs for how to obtain them (generate a CSR + keypair, submit the CSR to
# INSA, store the issued .pem). The private key never leaves the host.
EIRMS_SIGNING_PRIVATE_KEY_FILE=
EIRMS_SIGNING_CERT_FILE=

# Certificate onboarding target inbox. The in-app wizard renders a mailto:
# button that pre-fills this address; ops overrides during INSA rehearsals.
# Default (when unset) = icr@insa.gov.et.
EIRMS_CERTIFICATE_EMAIL=

# Seller (Zemen-ePos) profile stamped onto every outgoing invoice
EIRMS_SELLER_LEGAL_NAME=Zemen-ePos Financial Services S.C.
EIRMS_SELLER_EMAIL=einvoice@e-pay.et
EIRMS_SELLER_PHONE=+251911774343
EIRMS_SELLER_REGION=1
EIRMS_SELLER_WEREDA=13
EIRMS_SELLER_VAT_NUMBER=43256663343256663322

# Host-side development only. Docker Compose overrides this with DATABASE_URL
# from the repository-root .env so there is one deterministic Neon branch.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15&pool_timeout=20&connection_limit=5

# Prometheus + Grafana env vars used to live here, but they're consumed by
# docker-compose at `compose up` time (for `${VAR:-default}` interpolation)
# rather than by the api container at runtime. docker-compose reads them
# from the ROOT `.env`, not from this file, so they belong in the
# `.env.example` next to docker-compose.yml. See that file for METRICS_* and
# GRAFANA_* defaults.

# HashiCorp Vault — source of truth for per-branch EIRMS credentials. The
# vault-init sidecar in docker-compose creates the AppRole and writes the
# role-id/secret-id files at these paths. For host-side dev (outside docker),
# point them at the local files under ./vault/approle and set VAULT_ADDR to
# http://127.0.0.1:18200 (the host-facing port; container-to-container traffic
# uses vault:8200 internally).
VAULT_ADDR=http://vault:8200
VAULT_APPROLE_ROLE_ID_FILE=/vault/approle/role-id
VAULT_APPROLE_SECRET_ID_FILE=/vault/approle/secret-id

# Merchant data-export bundles (NTR C14). Path is inside the container;
# docker-compose maps it to ./exports on the host. Retention is the number
# of days a bundle stays downloadable before the hourly tick deletes it.
EXPORTS_STORAGE_DIR=/var/lib/eirms/exports
EXPORTS_RETENTION_DAYS=7

# Scheduled reports — recurring emailed summaries. Requires
# NOTIFICATIONS_ENABLED, since delivery goes through the same mail client.
REPORTS_ENABLED=false
# Renders and stores a run without mailing it. Safe way to inspect what a
# report would say in production.
REPORTS_DRY_RUN=false
REPORTS_MAX_RECIPIENTS=20
REPORTS_MAX_PER_MERCHANT=10
# Reports trail real time by this much. Postgres now() is transaction-start
# time, so a transaction that commits after a window closes would otherwise
# land in no window at all — an invisible, permanent gap. Do not set to 0.
REPORTS_COMMIT_LAG_MS=120000
REPORTS_MAX_ATTACHMENT_BYTES=5242880
REPORTS_TICK_MS=60000
REPORTS_CLAIM_BATCH=50
REPORTS_LEASE_MINUTES=15

# Cloudflare Turnstile — bot challenge on signup + login. The dev defaults
# below are Cloudflare's documented always-pass test keys, so the flow runs
# end-to-end without a real account. Replace both sides in prod.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Sentry error monitoring. DSN has a committed default; override per environment.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Auth
JWT_SECRET=set-a-long-random-string-here
SEED_SUPER_ADMIN_EMAIL=team@e-pay.et
SEED_SUPER_ADMIN_PASSWORD=replace-on-first-deploy

# Signup verification, login 2FA, and password reset use Gmail SMTP. Keep the
# app password in Vault/your deployment secret manager outside local dev.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
GMAIL_USER=<YOUR_GMAIL_ADDRESS>
GMAIL_APP_PASSWORD=<YOUR_GMAIL_APP_PASSWORD>
AUTH_EMAIL_FROM=<YOUR_GMAIL_ADDRESS>
AUTH_OTP_LENGTH=6
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
COOKIE_PATH=/auth
AUTH_OTP_TTL_SECONDS=900
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_PENDING_TOKEN_TTL_SECONDS=900
AUTH_FAILED_LOGIN_ALERT_THRESHOLD=5
# Optional Super Admin inbox for legal-document review alerts.
REGISTRATION_REVIEW_EMAIL=
LEGAL_DOCUMENT_MAX_BYTES=5242880
LEGAL_DOCUMENT_STORAGE_DIR=/var/lib/zemen/legal-documents

# CORS — comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:4999,https://einvoice.e-pay.et,https://eia.e-pay.et

# Reverse-proxy hop count for Express `trust proxy` (0 = no proxy, 1 = single
# nginx / traefik / caddy hop, higher for chained CDN→LB→app). Required for
# X-Forwarded-For to be honoured on req.ip, and for the IP filter below to
# see the real client.
TRUSTED_PROXY_HOPS=0

# Region access — comma-separated CIDR ranges. Both empty = no filter.
# ALLOW_LIST is a strict include: any IP outside it is refused.
# DISALLOW_LIST is a strict exclude and wins over ALLOW.
# The SPA renders a "not available for your region" screen on the 451 response.
IP_ALLOW_LIST=
IP_DISALLOW_LIST=

# Email notifications (Resend). Set NOTIFICATIONS_ENABLED=true to turn on; when
# off, no Redis/Resend is required. RESEND_API_KEY + EMAIL_FROM are required
# only when enabled.
# Offline invoice drafts. Parked — when false the POS never offers "save as
# draft", the /invoices/draft* endpoints 404, and the background sync job is
# not scheduled. Existing draft rows are left untouched.
DRAFTS_ENABLED=false

NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
# Resend webhook signing secret (whsec_*). Copy from the Resend dashboard →
# Webhooks → Add endpoint (URL = https://<api>/webhooks/resend). Signature
# verification uses svix; unsigned requests are refused.
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=Zemen-ePos e-Invoice <einvoice@e-pay.et>
# Comma-separated inbox(es) BCC'd on every notification (merchant audit copy)
EMAIL_MERCHANT_COPY=ops@e-pay.et
# Logo shown in emails. Defaults to APP_PUBLIC_URL/zemen-epos-logo.svg (served from the web
# app's public dir); set this only to override with a different absolute URL.
EMAIL_LOGO_URL=
# Web app base URL, used to build "view document" links in emails/SMS (the
# public, tokenized /p/invoices/:id Variant 1 invoice page buyers can print/PDF)
APP_PUBLIC_URL=https://einvoice.e-pay.et
# Google OAuth 2.0 Web application credentials. The redirect URI must exactly
# match the value registered in Google Cloud for this environment.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://einvoice.e-pay.et/api/auth/google/callback
# Secret for signing those public buyer links (HMAC). Optional — falls back to
# JWT_SECRET when unset. Set a dedicated value to rotate buyer links separately.
PUBLIC_LINK_SECRET=
# API base URL, used to build hosted QR image links embedded in emails
API_PUBLIC_URL=https://eia.e-pay.et
# Redis connection for the BullMQ notification queue
REDIS_URL=redis://localhost:6379

# SMS notifications (EchoWave gateway). Independent of email — set SMS_ENABLED=
# true to also text the buyer on document events. Requires NOTIFICATIONS_ENABLED
# =true (shares the same Redis/queue infra). BASE_URL/API_KEY/SHORT_CODE are
# required only when SMS_ENABLED=true.
SMS_ENABLED=false
SMS_BASE_URL=
SMS_API_KEY=
# Provisioned sender ID / short code registered to the API key (e.g. 644)
SMS_SHORT_CODE=
