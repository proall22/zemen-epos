# URL the browser uses to reach the EIRMS × Zemen-ePos API
VITE_API_URL=http://localhost:4899

# Sentry for the web app — separate project/DSN from the API (note the _WEB
# suffix). Leave empty to disable Sentry in the browser build.
VITE_SENTRY_DSN_WEB=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Cloudflare Turnstile site key (public). Empty disables the widget — the
# login/signup forms render without it. Dev default below is Cloudflare's
# documented always-pass test key; replace with the real site key in prod.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Offline invoice drafts — parked. Must match DRAFTS_ENABLED on the API.
VITE_DRAFTS_ENABLED=false
