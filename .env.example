# PostgreSQL runs privately in Docker on the VPS. Generate the password with
# `openssl rand -hex 32`; hexadecimal is URL-safe because Compose also uses it
# to construct the API's DATABASE_URL. Never change these values on an existing
# deployment without a planned database credential rotation.
POSTGRES_USER=zemen
POSTGRES_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
POSTGRES_DB=zemen
BACKUP_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=14
PRISMA_MIGRATE_RETRIES=6

# Authentication OTP email (Gmail SMTP). Use a Google App Password, never the
# account password. Production deployments should inject these from Vault or
# the platform secret manager rather than storing them in an env file.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
GMAIL_USER=<YOUR_GMAIL_ADDRESS>
GMAIL_APP_PASSWORD=<YOUR_GMAIL_APP_PASSWORD>
AUTH_EMAIL_FROM=<YOUR_GMAIL_ADDRESS>
AUTH_OTP_LENGTH=6
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# Docker/nginx exposes authentication under /api/auth. Set /auth when the
# browser calls the API directly without the same-origin gateway.
COOKIE_PATH=/api/auth
AUTH_OTP_TTL_SECONDS=900
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_PENDING_TOKEN_TTL_SECONDS=900
AUTH_FAILED_LOGIN_ALERT_THRESHOLD=5
# Optional Super Admin inbox for legal-document review alerts.
REGISTRATION_REVIEW_EMAIL=
LEGAL_DOCUMENT_MAX_BYTES=5242880
LEGAL_DOCUMENT_STORAGE_DIR=/var/lib/zemen/legal-documents

# Google OAuth 2.0 web-server flow. Create a Web application client in Google
# Cloud. Keep the client secret server-side; it must never use a VITE_ prefix.
APP_PUBLIC_URL=http://localhost:4999
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4999/api/auth/google/callback

# Web Sentry — baked into the web image at build time (Vite inlines VITE_ vars).
# Empty DSN disables Sentry in the browser build.
VITE_SENTRY_DSN_WEB=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Cloudflare Turnstile site key. Empty = widget hidden, login/signup work
# without challenge. Dev default is Cloudflare's always-pass test key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Prometheus → API scrape credentials. docker-compose passes these into the
# api container; the api enforces basic auth on /metrics with the same pair.
# Defaults match observability/prometheus/prometheus.yml.
METRICS_USER=metrics
METRICS_PASS=metrics

# Grafana — read by docker-compose at `compose up` time. CHANGE the admin
# password before exposing the UI publicly. Note: Grafana writes this
# password to its sqlite on FIRST boot only; later env changes are ignored
# until you reset it (see observability/README.md).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Alert routing. SMTP relay is Resend (uses RESEND_API_KEY from
# apps/api/.env); only the destination + from-address live here.
GRAFANA_ALERT_EMAIL_TO=ops@e-pay.et
GRAFANA_ALERT_FROM=alerts@e-pay.et
GRAFANA_ALERT_FROM_NAME=EIRMS Alerts
EIRMS_CERT_DIR=
EIRMS_SYSTEM_NUMBER=
EIRMS_SYSTEM_TYPE=POS
# Set true only when provisioning/updating the legacy system-owner default branch.
EIRMS_SEED_DEFAULT_CREDENTIALS=false
# Inventory images are persisted by Docker under ./uploads. The database
# stores only the returned /inventory/images/<filename> URL on the item.
IMAGE_UPLOAD_DIR=/var/lib/zemen/uploads/inventory
