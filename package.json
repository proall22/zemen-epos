{
  "name": "eirms-epay",
  "version": "0.1.0",
  "private": true,
  "description": "EIRMS × Zemen-ePos monorepo — NestJS API + Vite/React POS UI",
  "packageManager": "pnpm@10.21.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @eirms/api start:dev",
    "dev:web": "pnpm --filter @eirms/web dev",
    "lint": "pnpm -r lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ],
    "ignoredBuiltDependencies": [
      "@nestjs/core",
      "@scarf/scarf",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "marked": "^18.0.4",
    "pdfkit": "^0.18.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2"
  }
}
